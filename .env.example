# Copy to .env and fill in. Never commit .env.

PORT=8080

# PostgreSQL (Supabase). Use the direct or session-pooler connection string;
# the transaction pooler (port 6543) does not support prepared statements.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/postgres

# Supabase project URL, used to verify web login tokens (JWKS).
# The project must use asymmetric JWT signing keys; legacy HS256 tokens are rejected.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# LINE Login channel ID that owns the LIFF app (Worker login).
LINE_LOGIN_CHANNEL_ID=YOUR_LINE_LOGIN_CHANNEL_ID

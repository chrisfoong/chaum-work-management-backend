# Placeholders only. Never commit .env.
PORT=8080
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/postgres?sslmode=require
LINE_WEB_CHANNEL_ID=
LINE_WORKER_CHANNEL_ID=
# Both channels must belong to this provider; verify in LINE Developers Console.
LINE_PROVIDER_ID=
# At least 32 random bytes; blank blocks QR issuance and check-in.
QR_SIGNING_SECRET=
# Existing private Storage bucket. Do not create policies automatically.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BUCKET=
LINE_MESSAGING_TOKEN=
# Local isolated integration database only. Leave blank for unit tests.
TEST_DATABASE_URL=
TEST_DATABASE_ISOLATED=

# Comma-separated explicit browser origins. Do not use wildcard.
WEB_ALLOWED_ORIGINS=http://localhost:3000
